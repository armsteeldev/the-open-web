---
import { spaces } from '../../../../packages/shared/spaces';
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<details class="top-disclosure global-menu" data-top-disclosure>
  <summary aria-label="Spaces" aria-controls="global-menu-panel" title="Spaces">☰</summary>
  <div class="menu-panel" id="global-menu-panel">
    <div class="menu-label">The Open Web</div>
    <nav aria-label="Spaces">
      {spaces.map(space => <a href={space.path} aria-current={current === space.path.replace(/\/+$/, '') || current.startsWith(space.path.replace(/\/+$/, '') + '/') ? 'page' : undefined}>{space.label}</a>)}
    </nav>
  </div>
</details>
<script>
  const disclosures = [...document.querySelectorAll<HTMLDetailsElement>('[data-top-disclosure]')];
  const closeOthers = (current?: HTMLDetailsElement) => {
    disclosures.forEach(disclosure => {
      if (disclosure !== current) disclosure.open = false;
    });
  };

  disclosures.forEach(disclosure => {
    disclosure.addEventListener('toggle', () => {
      if (disclosure.open) closeOthers(disclosure);
    });
    disclosure.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { disclosure.open = false; }));
  });

  document.addEventListener('pointerdown', event => {
    const target = event.target as Element | null;
    const inside = target?.closest('[data-top-disclosure]') as HTMLDetailsElement | null;
    const hadOpenDisclosure = disclosures.some(disclosure => disclosure.open);
    closeOthers(inside ?? undefined);
    // The dismissing tap must not also place or drag a canvas pixel.
    if (hadOpenDisclosure && !inside && target instanceof HTMLCanvasElement) {
      event.preventDefault();
      event.stopImmediatePropagation();
    }
  }, true);

  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    const open = disclosures.find(disclosure => disclosure.open);
    if (!open) return;
    open.open = false;
    open.querySelector<HTMLElement>('summary')?.focus();
  });

  window.addEventListener('pageshow', () => closeOthers());
</script>
<style is:global>
  .top-disclosure { position: relative; }
  .top-disclosure > summary { list-style: none; display: grid; place-items: center; }
  .top-disclosure > summary::-webkit-details-marker { display: none; }
  .menu-panel { position: absolute; top: calc(100% + 3px); left: 0; width: min(180px, calc(100vw - 16px - env(safe-area-inset-left) - env(safe-area-inset-right))); background: #fafafa; border: 1px solid #aaa; color: #333; box-shadow: 0 2px 8px #0002; }
  .help-disclosure .menu-panel { left: auto; right: 0; padding: 8px; }
  .menu-label { padding: 7px 9px 3px; color: #666; }
  nav { padding: 2px 4px 4px; }
  nav a { display: block; color: inherit; text-decoration: none; padding: 6px; }
  nav a:hover { background: #eee; }
  nav a[aria-current="page"] { background: #e5e5e5; }
  nav a:focus-visible { outline: 2px solid #345ea7; outline-offset: -2px; }
</style>
