---
import SpaceLayout from '../layouts/SpaceLayout.astro';
---
<SpaceLayout title="Global Chat — The Open Web" layout="viewport">
  <main class="chat" id="chat" aria-label="Global Chat">
    <header class="chat-header">
      <h1 id="chat-title">Global Chat</h1>
      <span id="connection-status" class="connection" data-state="connecting" role="status" aria-live="polite" aria-atomic="true">Connecting</span>
      <button id="identity-button" class="identity-button" type="button" aria-label="Change nickname" aria-haspopup="dialog" aria-controls="nickname-dialog" title="Change nickname">
        <span id="identity-label">Checking your name…</span> <span class="identity-edit" aria-hidden="true">Change</span>
      </button>
    </header>

    <section class="message-region" id="message-region" tabindex="0" aria-label="Recent conversation">
      <ol id="messages" aria-label="Recent messages" aria-live="off"></ol>
      <p id="empty-state" class="empty-state" aria-live="polite">Loading messages…</p>
      <button id="newest" class="newest" type="button" hidden>Jump to newest</button>
    </section>

    <footer class="chat-footer">
      <form id="composer" class="composer">
        <label class="visually-hidden" for="message-input">Message</label>
        <input id="message-input" name="message" type="text" maxlength="360" autocomplete="off" placeholder="Write a message" enterkeyhint="send" aria-describedby="send-feedback" />
        <button id="send" type="submit">Send</button>
      </form>
      <p id="send-feedback" class="feedback" data-state="" role="status" aria-live="polite" aria-atomic="true"></p>
    </footer>

    <dialog id="nickname-dialog" class="nickname-dialog" aria-labelledby="nickname-title" aria-describedby="nickname-description">
      <h2 id="nickname-title">Change nickname</h2>
      <form id="nickname-form" class="nickname-form">
        <label class="visually-hidden" for="nickname">Optional nickname</label>
        <input id="nickname" type="text" maxlength="48" autocomplete="nickname" spellcheck="false" placeholder="Optional nickname" />
        <p id="nickname-description" class="nickname-hint">Applies to new messages only.</p>
        <p id="nickname-feedback" class="nickname-feedback" role="alert" aria-live="polite" hidden></p>
        <div class="dialog-actions">
          <button id="nickname-cancel" type="button">Cancel</button>
          <button class="save-nickname" type="submit">Save</button>
        </div>
      </form>
    </dialog>
  </main>
  <script>import '../spaces/chat/client';</script>
</SpaceLayout>

<style is:global>
  .chat {
    height: 100vh;
    height: var(--chat-viewport-height, 100dvh);
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: max(43px, calc(env(safe-area-inset-top) + 35px)) max(8px, env(safe-area-inset-right)) max(8px, env(safe-area-inset-bottom)) max(8px, env(safe-area-inset-left));
    overflow: hidden;
    color: var(--ow-text);
    transform: translateY(var(--chat-viewport-offset-top, 0px));
  }

  .chat *, .chat *::before, .chat *::after { box-sizing: border-box; }
  .chat [hidden] { display: none !important; }
  .chat .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .chat-header { min-height: 36px; display: flex; align-items: center; gap: 12px; padding-left: 38px; padding-right: 2px; }
  .chat-header h1 { margin: 0; color: var(--ow-text); font-size: 15px; font-weight: 600; white-space: nowrap; }
  .connection { display: inline-flex; align-items: center; gap: 5px; color: #555; font-size: 12px; white-space: nowrap; }
  .connection::before { width: 6px; height: 6px; flex: 0 0 6px; border-radius: 50%; background: #999; content: ''; }
  .connection[data-state="connected"]::before { background: #5c8062; }
  .connection[data-state="disconnected"]::before, .connection[data-state="reconnecting"]::before { background: #a45c49; }

  .identity-button { display: inline-flex; align-items: center; gap: 7px; max-width: min(46vw, 400px); min-width: 0; min-height: 30px; height: auto; margin-left: auto; padding: 3px 4px; border: 0; border-radius: 2px; background: transparent; color: #555; font: inherit; font-size: 12px; text-align: right; cursor: pointer; }
  .identity-button #identity-label { min-width: 0; overflow-wrap: anywhere; }
  .identity-button #identity-label[data-kind="anonymous"] { white-space: nowrap; overflow-wrap: normal; }
  .identity-edit { flex: 0 0 auto; color: #555; font-size: 11px; }
  .identity-button:hover { color: var(--ow-text); text-decoration: underline dotted; text-underline-offset: 3px; }

  .message-region { position: relative; flex: 1; min-height: 0; overflow: auto; overflow-anchor: none; overscroll-behavior: contain; border: 1px solid var(--ow-border); background: var(--ow-surface); scrollbar-gutter: stable; padding: 4px 8px; scroll-padding-block: 8px; }
  .message-region:focus-visible { outline: 2px solid var(--ow-focus); outline-offset: -2px; }
  #messages { list-style: none; margin: 0; padding: 0; }
  .message { display: grid; grid-template-columns: 5.1em fit-content(17rem) minmax(0, 1fr); gap: 8px; align-items: baseline; min-width: 0; padding: 3px 0; line-height: 1.4; }
  .message time { color: var(--ow-muted); font-size: 11px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .message .sender { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px; min-width: 0; overflow-wrap: anywhere; }
  .message .nickname { color: #3c4d5f; font-weight: 600; overflow-wrap: anywhere; }
  .message .identity-tag { color: var(--ow-muted); font-size: 11px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .message .text { min-width: 0; color: var(--ow-text); overflow-wrap: anywhere; word-break: break-word; white-space: pre-wrap; }
  .empty-state { margin: 8px 0; color: var(--ow-muted); }
  .newest { position: sticky; z-index: 1; float: right; bottom: 6px; min-height: 30px; height: auto; margin: 6px 2px 2px auto; padding: 4px 9px; box-shadow: 0 1px 3px #0002; }

  .chat-footer { display: flex; flex-direction: column; gap: 2px; }
  .composer { display: flex; align-items: stretch; gap: 6px; margin: 0; }
  .composer input { min-width: 0; flex: 1; height: 40px; padding: 7px 9px; border: 1px solid var(--ow-border); border-radius: 2px; background: var(--ow-surface); color: var(--ow-text); font: inherit; font-size: 16px; }
  .composer input:focus-visible, .nickname-form input:focus-visible { outline: 2px solid var(--ow-focus); outline-offset: 1px; }
  .composer button { min-width: 62px; height: 40px; padding: 0 12px; }
  .composer button:disabled { cursor: wait; opacity: .65; }
  .feedback { min-height: 16px; margin: 0 2px; color: var(--ow-muted); font-size: 12px; line-height: 1.4; }
  .feedback[data-state="error"], .feedback[data-state="cooldown"] { color: #8b4936; }
  .feedback[data-state="pending"] { color: #555; }
  .feedback[data-state="success"] { color: #48694d; }

  .nickname-dialog { width: min(360px, calc(100% - 28px)); max-width: 360px; padding: 16px; border: 1px solid var(--ow-border); border-radius: 2px; background: var(--ow-surface); color: var(--ow-text); box-shadow: 0 4px 18px #0003; }
  .nickname-dialog::backdrop { background: #0005; }
  .nickname-dialog h2 { margin: 0 0 12px; font-size: 16px; font-weight: 600; }
  .nickname-form { display: grid; gap: 8px; }
  .nickname-form input { width: 100%; min-width: 0; height: 40px; padding: 7px 9px; border: 1px solid var(--ow-border); border-radius: 2px; background: var(--ow-surface); color: var(--ow-text); font: inherit; font-size: 16px; }
  .nickname-hint, .nickname-feedback { margin: 0; color: var(--ow-muted); font-size: 12px; line-height: 1.4; }
  .nickname-feedback { color: #8b4936; }
  .dialog-actions { display: flex; justify-content: flex-end; gap: 6px; margin-top: 4px; }
  .dialog-actions button { min-width: 62px; height: 36px; padding: 0 10px; }
  .dialog-actions .save-nickname { color: var(--ow-text); background: #eee; }

  @media (max-width: 480px) {
    .chat { gap: 5px; padding-top: max(42px, calc(env(safe-area-inset-top) + 36px)); }
    .chat-header { min-height: 42px; flex-wrap: wrap; gap: 7px; }
    .chat-header h1 { font-size: 14px; }
    .identity-button { max-width: 62vw; min-height: 36px; gap: 4px; padding-inline: 3px; }
    .message-region { padding: 4px 6px; }
    .message { grid-template-columns: minmax(0, 1fr) auto; gap: 2px 8px; padding: 6px 0; }
    .message .sender { grid-column: 1; grid-row: 1; }
    .message time { grid-column: 2; grid-row: 1; align-self: baseline; }
    .message .text { grid-column: 1 / -1; grid-row: 2; font-size: 14px; }
    .composer input, .composer button { height: 42px; }
  }

  @media (max-width: 360px) {
    .chat-header { padding-left: 36px; }
    .identity-button { max-width: 65vw; font-size: 11px; }
    .message-region { padding-inline: 6px; }
    .composer button { min-width: 56px; padding-inline: 8px; }
  }

  @media (orientation: landscape) and (max-height: 520px) {
    .chat { padding-top: max(36px, calc(env(safe-area-inset-top) + 30px)); }
    .chat-header { min-height: 30px; }
    .message-region { padding-block: 2px; }
    .composer input, .composer button { height: 36px; }
    .feedback { min-height: 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat *, .chat *::before, .chat *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
