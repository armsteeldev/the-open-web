---
import SpaceLayout from '../layouts/SpaceLayout.astro';
---
<SpaceLayout title="Global Chat — The Open Web" layout="viewport">
  <main class="chat" id="chat" aria-label="Global Chat">
    <header class="chat-header">
      <h1>Global Chat</h1>
      <span id="connection-status" role="status" aria-live="polite" aria-atomic="true">Connecting</span>
      <label class="nickname-control" for="nickname">Nickname <input id="nickname" type="text" maxlength="48" autocomplete="nickname" spellcheck="false" placeholder="Anonymous" /></label>
    </header>

    <div class="message-region" id="message-region">
      <ol id="messages" aria-label="Recent messages" aria-live="off"></ol>
      <p id="empty-state">No messages yet. Say hello.</p>
      <button id="newest" class="newest" type="button" hidden>New messages · Jump to newest</button>
    </div>

    <form id="composer" class="composer">
      <label class="visually-hidden" for="message-input">Message</label>
      <input id="message-input" name="message" type="text" maxlength="360" autocomplete="off" placeholder="Write a message" aria-describedby="send-feedback" />
      <button id="send" type="submit">Send</button>
    </form>
    <p id="send-feedback" class="feedback" role="status" aria-live="polite" aria-atomic="true"></p>
  </main>
  <script>import '../spaces/chat/client';</script>
</SpaceLayout>

<style is:global>
  .visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  .chat{height:100vh;height:100dvh;min-height:0;display:flex;flex-direction:column;gap:7px;padding:43px max(8px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(8px,env(safe-area-inset-left));overflow:hidden}
  .chat-header{min-height:36px;display:flex;align-items:center;gap:12px;padding-left:38px;padding-right:2px}
  .chat-header h1{font-size:15px;font-weight:600;margin:0;white-space:nowrap}
  #connection-status{font-size:12px;color:#555;white-space:nowrap}
  .nickname-control{margin-left:auto;display:flex;align-items:center;gap:6px;color:#555;white-space:nowrap}
  .nickname-control input{width:min(180px,32vw);height:30px;padding:4px 7px;border:1px solid var(--ow-border);border-radius:2px;background:var(--ow-surface);color:var(--ow-text);font:inherit}
  .nickname-control input:focus-visible,.composer input:focus-visible{outline:2px solid var(--ow-focus);outline-offset:1px}
  .message-region{position:relative;flex:1;min-height:0;overflow:auto;overscroll-behavior:contain;border:1px solid var(--ow-border);background:var(--ow-surface);scrollbar-gutter:stable;padding:4px 8px}
  #messages{list-style:none;margin:0;padding:0}
  .message{display:grid;grid-template-columns:5.4em auto minmax(0,1fr);gap:8px;align-items:baseline;padding:3px 0;line-height:1.4;overflow-wrap:anywhere}
  .message time{font-size:11px;color:var(--ow-muted);font-variant-numeric:tabular-nums;white-space:nowrap}
  .message .nickname{font-weight:600;color:#3c4d5f;overflow-wrap:anywhere}
  .message .text{white-space:pre-wrap}
  #empty-state{margin:8px 0;color:var(--ow-muted)}
  .newest{position:sticky;float:right;bottom:6px;margin:6px 2px 2px auto;z-index:1;min-height:30px;padding:4px 9px;box-shadow:0 1px 3px #0002}
  .composer{display:flex;gap:6px;align-items:stretch;margin:0}
  .composer input{min-width:0;flex:1;height:40px;padding:7px 9px;border:1px solid var(--ow-border);border-radius:2px;background:var(--ow-surface);color:var(--ow-text);font:inherit;font-size:16px}
  .composer button{height:40px;min-width:62px;padding:0 12px}
  .composer button:disabled{cursor:default;color:var(--ow-muted)}
  .feedback{min-height:16px;margin:0 2px;color:var(--ow-muted);font-size:12px}
  @media(max-width:480px){
    .chat{gap:5px;padding-top:max(42px,env(safe-area-inset-top) + 36px)}
    .chat-header{gap:7px;flex-wrap:wrap;min-height:42px}
    .chat-header h1{font-size:14px}
    .nickname-control{gap:4px}
    .nickname-control input{width:min(130px,34vw)}
    .message-region{padding:4px 6px}
    .message{grid-template-columns:4.4em auto minmax(0,1fr);gap:5px}
    .composer input{height:42px}
    .composer button{height:42px}
  }
  @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
</style>
