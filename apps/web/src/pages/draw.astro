---
import SpaceLayout from '../layouts/SpaceLayout.astro';
---
<SpaceLayout title="The Drawing Board — The Open Web" layout="document">
  <main class="draw" aria-labelledby="draw-title">
    <header class="draw-heading">
      <h1 id="draw-title">The Drawing Board</h1>
      <nav class="draw-nav" aria-label="Drawing Board">
        <button id="create-view" type="button" aria-pressed="true">Draw</button>
        <button id="gallery-view" type="button" aria-pressed="false">Browse</button>
      </nav>
    </header>

    <section id="create-panel" class="create-panel" aria-label="Make a drawing">
      <div class="paper-frame">
        <canvas id="draw-surface" width="1000" height="700" tabindex="0" role="application"
          aria-label="Blank drawing surface"
          aria-describedby="draw-instructions"></canvas>
      </div>
      <p id="draw-instructions" class="draw-instructions">Draw with a mouse, finger or pen. For keyboard drawing, focus the paper: arrow keys move, Space starts or extends a line, and Escape ends it.</p>
      <span id="draw-keyboard-status" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></span>
      <div class="drawing-tools">
        <div class="tool-group" role="group" aria-label="Drawing tool">
          <button type="button" data-tool="pen" aria-pressed="true">Pen</button>
          <button type="button" data-tool="eraser" aria-pressed="false">Eraser</button>
        </div>
        <div id="color-tools" class="color-tools" role="group" aria-label="Ink colour">
          <button type="button" data-color="0" style="--ink:#262626" aria-label="Charcoal" aria-pressed="true"></button>
          <button type="button" data-color="1" style="--ink:#e05a47" aria-label="Red" aria-pressed="false"></button>
          <button type="button" data-color="2" style="--ink:#e3ad35" aria-label="Ochre" aria-pressed="false"></button>
          <button type="button" data-color="3" style="--ink:#418b67" aria-label="Green" aria-pressed="false"></button>
          <button type="button" data-color="4" style="--ink:#4d77b5" aria-label="Blue" aria-pressed="false"></button>
          <button type="button" data-color="5" style="--ink:#8b64a8" aria-label="Violet" aria-pressed="false"></button>
        </div>
        <div class="tool-group" role="group" aria-label="Brush size">
          <button type="button" data-size="0" aria-label="Small brush" aria-pressed="false">·</button>
          <button type="button" data-size="1" aria-label="Medium brush" aria-pressed="true">●</button>
          <button type="button" data-size="2" aria-label="Large brush" aria-pressed="false">●</button>
        </div>
        <div class="history-tools" role="group" aria-label="Drawing history">
          <button id="undo-drawing" type="button" aria-label="Undo" disabled>Undo</button>
          <button id="redo-drawing" type="button" aria-label="Redo" disabled>Redo</button>
          <button id="clear-drawing" type="button">Clear</button>
          <button id="submit-drawing" type="button" disabled>Leave it</button>
        </div>
      </div>
      <p id="draw-feedback" class="draw-feedback" role="status" aria-live="polite" aria-atomic="true"></p>
    </section>

    <section id="gallery-panel" class="gallery-panel" aria-label="Drawings left by visitors" hidden>
      <p id="gallery-empty" class="gallery-empty" hidden>No drawings left yet. Make the first one.</p>
      <div id="drawing-gallery" class="drawing-gallery"></div>
      <button id="older-drawings" class="older-drawings" type="button" hidden>Older drawings</button>
      <p id="gallery-feedback" class="draw-feedback" role="status" aria-live="polite" aria-atomic="true"></p>
    </section>

    <dialog id="drawing-viewer" class="drawing-viewer" aria-labelledby="viewer-title">
      <div class="viewer-heading">
        <h2 id="viewer-title">A drawing</h2>
        <button id="close-viewer" type="button" aria-label="Close drawing">Close</button>
      </div>
      <canvas id="viewer-surface" width="1000" height="700" aria-label="Selected drawing"></canvas>
    </dialog>
  </main>
  <script>import '../spaces/draw/client';</script>
</SpaceLayout>

<style is:global>
  .draw { width: min(100%, 1180px); min-height: 100vh; min-height: 100svh; margin: 0 auto; padding: max(52px, calc(env(safe-area-inset-top) + 42px)) max(14px, env(safe-area-inset-right)) max(20px, env(safe-area-inset-bottom)) max(14px, env(safe-area-inset-left)); }
  .draw *, .draw *::before, .draw *::after { box-sizing: border-box; }
  .draw [hidden] { display: none !important; }
  .draw .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
  .draw-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:36px; margin:0 0 12px; padding-left:34px; }
  .draw-heading h1 { margin:0; font-size:17px; font-weight:600; }
  .draw-nav { display:flex; gap:4px; }
  .draw-nav button,.drawing-tools button,.older-drawings,.viewer-heading button { min-height:34px; height:auto; padding:4px 10px; }
  .draw-nav button[aria-pressed="true"] { background:#e7e6e1; }
  .create-panel { display:flex; flex-direction:column; align-items:center; }
  .paper-frame { width:min(100%, 1000px); aspect-ratio:10 / 7; background:#fff; border:1px solid #aaa; box-shadow:0 1px 3px #0002; }
  #draw-surface,.drawing-card canvas,#viewer-surface { display:block; width:100%; height:100%; background:#fff; touch-action:none; }
  #draw-surface { cursor:crosshair; }
  #draw-surface:focus-visible { outline:3px solid var(--ow-focus); outline-offset:2px; }
  .draw-instructions { width:min(100%,1000px); margin:7px 0 6px; color:var(--ow-muted); font-size:11px; line-height:1.4; }
  .drawing-tools { width:min(100%,1000px); display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:6px; }
  .tool-group,.color-tools,.history-tools { display:flex; align-items:center; gap:3px; }
  .drawing-tools [aria-pressed="true"] { outline:2px solid #52534f; outline-offset:-3px; }
  .color-tools button { width:28px; min-width:28px; height:28px; min-height:28px; padding:2px; border:1px solid #85857e; border-radius:50%; background:var(--ink); }
  .color-tools button[aria-pressed="true"] { outline:2px solid #333; outline-offset:2px; }
  .tool-group button[data-size="0"] { font-size:20px; }
  .tool-group button[data-size="1"] { font-size:12px; }
  .tool-group button[data-size="2"] { font-size:19px; }
  .drawing-tools button:disabled { opacity:.45; cursor:not-allowed; }
  .draw-feedback { min-height:18px; width:min(100%,1000px); margin:5px 0 0; color:var(--ow-muted); font-size:12px; }
  .draw-feedback[data-state="error"] { color:#8b4936; }
  .draw-feedback[data-state="success"] { color:#48694d; }
  .gallery-panel { width:100%; }
  .gallery-empty { margin:38px 0; text-align:center; color:var(--ow-muted); }
  .drawing-gallery { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px; }
  .drawing-card { min-width:0; padding:0; border:1px solid #b1b1a9; background:#fff; cursor:pointer; }
  .drawing-card canvas { aspect-ratio:10 / 7; height:auto; }
  .drawing-card:hover { border-color:#555; }
  .drawing-card:focus-visible { outline:2px solid var(--ow-focus); outline-offset:2px; }
  .drawing-card-label { display:block; padding:5px 7px; text-align:left; color:var(--ow-muted); font-size:11px; }
  .older-drawings { display:block; margin:16px auto; }
  .drawing-viewer { width:min(94vw, 1000px); max-width:1000px; padding:12px; border:1px solid var(--ow-border); background:var(--ow-surface); }
  .drawing-viewer::backdrop { background:#2228; }
  .viewer-heading { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:8px; }
  .viewer-heading h2 { margin:0; font-size:14px; font-weight:500; }
  #viewer-surface { height:auto; aspect-ratio:10 / 7; border:1px solid #ccc; }
  @media(max-width:760px) { .drawing-gallery { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  @media(max-width:560px) {
    .draw { padding-left:max(10px,env(safe-area-inset-left)); padding-right:max(10px,env(safe-area-inset-right)); }
    .draw-heading { padding-left:36px; margin-bottom:8px; }
    .draw-heading h1 { font-size:16px; }
    .drawing-tools { justify-content:flex-start; gap:5px; }
    .history-tools { margin-left:auto; }
    .drawing-tools button { min-height:36px; }
    .color-tools { gap:5px; }
    .color-tools button { min-width:27px; width:27px; height:27px; min-height:27px; }
    .drawing-gallery { grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px; }
    .draw-instructions { font-size:10px; }
  }
  @media(prefers-reduced-motion:reduce) { .draw *, .draw *::before, .draw *::after { scroll-behavior:auto !important; transition:none !important; animation:none !important; } }
</style>
