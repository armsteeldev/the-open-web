---
import GlobalMenu from '../components/GlobalMenu.astro';
interface Props {
  title?: string;
  /** `viewport` is for activities such as The Wall that own the whole screen. */
  layout?: 'document' | 'viewport';
}
const { title = 'The Open Web', layout = 'document' } = Astro.props;
---
<!doctype html><html lang="en" data-layout={layout}><head><meta charset="utf-8"/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/><title>{title}</title></head><body data-layout={layout}>
<slot />
<GlobalMenu /><div class="utility"><slot name="utility" /></div>
</body></html>
<style is:global>
:root{
  font:13px system-ui,sans-serif;
  color:#333;
  background:#d7d7d7;
  color-scheme:light;
  --ow-page:#d7d7d7;
  --ow-surface:#fafafa;
  --ow-border:#aaa;
  --ow-text:#333;
  --ow-muted:#666;
  --ow-hover:#eee;
  --ow-active:#e5e5e5;
  --ow-focus:#345ea7;
  --ow-control-size:30px;
}
*{box-sizing:border-box}
html{min-height:100%;background:var(--ow-page)}
html[data-layout="viewport"]{height:100%;overflow:hidden}
body{min-height:100vh;min-height:100svh;margin:0;color:var(--ow-text);background:var(--ow-page)}
body[data-layout="viewport"]{height:100vh;height:100dvh;min-height:0;overflow:hidden}
button,summary{font:inherit;color:inherit;background:var(--ow-surface);border:1px solid var(--ow-border);border-radius:2px;min-width:var(--ow-control-size);height:var(--ow-control-size);cursor:pointer}
button:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--ow-focus);outline-offset:2px}
.utility{position:fixed;z-index:10;top:max(8px,env(safe-area-inset-top));right:max(8px,env(safe-area-inset-right));display:flex;gap:4px}
</style>
